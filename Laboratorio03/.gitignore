# Segredos: o token do GitHub vem SEMPRE da variavel de ambiente GITHUB_TOKEN.
.env
.env.*

# Cache das respostas da API (pode ter varios GB; e regenerado pela coleta).
cache/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/

# Notebooks
.ipynb_checkpoints/

# Coleta bruta em JSONL (centenas de MB, acima do limite do GitHub); e regenerada
# a partir do cache por python -m pipeline. Os CSVs de dados/ sao versionados.
dados/*.jsonl

# Saidas de rodadas sobre subamostras (python -m pipeline --repos ... --saida dados_replicacao).
dados_replicacao/
